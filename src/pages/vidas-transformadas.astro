---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Section from '@/components/Section.astro';
import { site } from '@/config/site';

const title = `Vidas Transformadas, depoimentos sobre ${site.professionalName}`;
const description = `Histórias de famílias atendidas por ${site.professionalName}, ${site.profession.toLowerCase()} em ${site.city}. Leia os depoimentos e compartilhe a sua história.`;
---

<BaseLayout title={title} description={description} path="/vidas-transformadas">
  <Breadcrumbs items={[{ label: 'Início', href: '/' }, { label: 'Vidas Transformadas', href: '/vidas-transformadas' }]} />

  <Section eyebrow="Depoimentos" title="Vidas Transformadas" as="h1" narrow>
    <p class="max-w-2xl text-lg leading-relaxed text-ink/90">
      Cada criança que aprende a confiar em si transforma a vida de uma família inteira.
      Aqui, quem já viveu essa transformação conta como foi.
    </p>

    <!-- Depoimentos (approved entries, newest first; full text, no "ler mais") -->
    <div id="depoimentos-lista" class="mt-10 space-y-6" aria-live="polite"></div>
    <p id="depoimentos-vazio" class="mt-10 hidden rounded-2xl border border-dashed border-brand-200 bg-brand-50/50 p-8 text-center font-display text-xl text-brand-700">
      As primeiras histórias vão aparecer aqui em breve. Que tal começar pela sua?
    </p>
  </Section>

  <Section class="bg-white" narrow>
    <div class="rounded-3xl border border-brand-100 bg-cream p-7 sm:p-10">
      <h2 class="font-display text-2xl font-semibold text-brand-800 sm:text-3xl">
        Como esse atendimento mudou sua vida? Conta pra gente!
      </h2>

      <form id="depoimento-form" class="mt-7 space-y-5" novalidate>
        <div>
          <label for="dep-comentario" class="mb-1.5 block font-semibold text-brand-800">Seu depoimento</label>
          <textarea
            id="dep-comentario"
            name="comentario"
            required
            rows="5"
            maxlength="4000"
            class="w-full rounded-2xl border border-brand-200 bg-paper px-4 py-3 text-ink outline-none transition focus:border-brand-400 focus:ring-2 focus:ring-brand-200"
            placeholder="Conte sua história..."></textarea>
        </div>
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="dep-nome" class="mb-1.5 block font-semibold text-brand-800">Seu nome</label>
            <input
              id="dep-nome"
              name="nome"
              type="text"
              required
              maxlength="120"
              class="w-full rounded-full border border-brand-200 bg-paper px-4 py-3 text-ink outline-none transition focus:border-brand-400 focus:ring-2 focus:ring-brand-200"
            />
          </div>
          <div>
            <label for="dep-paciente" class="mb-1.5 block font-semibold text-brand-800">
              Nome e idade do paciente <span class="font-normal text-muted">(opcional)</span>
            </label>
            <input
              id="dep-paciente"
              name="paciente"
              type="text"
              maxlength="120"
              class="w-full rounded-full border border-brand-200 bg-paper px-4 py-3 text-ink outline-none transition focus:border-brand-400 focus:ring-2 focus:ring-brand-200"
            />
          </div>
        </div>
        <!-- honeypot: humans never see or fill this -->
        <div class="hidden" aria-hidden="true">
          <label for="dep-website">Não preencha este campo</label>
          <input id="dep-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <label class="flex items-start gap-3 text-sm text-ink/90">
          <input id="dep-consent" name="consent" type="checkbox" required class="mt-0.5 h-5 w-5 rounded border-brand-300 accent-brand-600" />
          <span>Autorizo a publicação do meu depoimento nesta página.</span>
        </label>
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
          <button
            type="submit"
            id="dep-enviar"
            class="inline-flex items-center justify-center rounded-full bg-brand-600 px-7 py-3.5 font-semibold text-white transition-colors hover:bg-brand-700 disabled:opacity-60"
          >
            Enviar meu depoimento
          </button>
          <p id="dep-erro" class="hidden text-sm font-medium text-red-700"></p>
        </div>
      </form>

      <div id="dep-sucesso" class="hidden">
        <p class="font-display text-2xl leading-snug text-brand-700">
          Muito obrigada por compartilhar sua história e me ajudar a transformar cada vez mais vidas!
        </p>
        <p class="mt-3 text-muted">Seu depoimento aparece aqui depois de uma revisão rápida.</p>
      </div>
    </div>
  </Section>
</BaseLayout>

<script>
  // Approved depoimentos load client-side so new entries appear without a rebuild.
  const lista = document.getElementById('depoimentos-lista')!;
  const vazio = document.getElementById('depoimentos-vazio')!;

  function cardHtml(d: { nome: string; paciente?: string | null; comentario: string }): string {
    const div = document.createElement('div');
    const quem = d.paciente ? `${d.nome} · ${d.paciente}` : d.nome;
    const p = document.createElement('blockquote');
    p.className = 'rounded-2xl border border-brand-100 bg-paper p-6 sm:p-8';
    const texto = document.createElement('p');
    texto.className = 'whitespace-pre-line font-display text-lg leading-relaxed text-ink';
    texto.textContent = d.comentario;
    const autor = document.createElement('footer');
    autor.className = 'mt-4 font-semibold text-brand-700';
    autor.textContent = `— ${quem}`;
    p.append(texto, autor);
    div.append(p);
    return div.innerHTML;
  }

  async function carregar() {
    try {
      const res = await fetch('/api/depoimentos');
      if (!res.ok) throw new Error(String(res.status));
      const data = await res.json();
      const items = data?.depoimentos ?? [];
      if (!items.length) throw new Error('vazio');
      lista.innerHTML = items.map(cardHtml).join('');
    } catch {
      vazio.classList.remove('hidden');
    }
  }
  carregar();

  const form = document.getElementById('depoimento-form') as HTMLFormElement;
  const erro = document.getElementById('dep-erro')!;
  const botao = document.getElementById('dep-enviar') as HTMLButtonElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    erro.classList.add('hidden');
    if (!form.reportValidity()) return;
    botao.disabled = true;
    const fd = new FormData(form);
    try {
      const res = await fetch('/api/depoimentos', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          nome: fd.get('nome'),
          paciente: fd.get('paciente') || null,
          comentario: fd.get('comentario'),
          consent: fd.get('consent') === 'on',
          website: fd.get('website') || '',
        }),
      });
      if (!res.ok) throw new Error(String(res.status));
      form.classList.add('hidden');
      document.getElementById('dep-sucesso')!.classList.remove('hidden');
    } catch {
      botao.disabled = false;
      erro.textContent = 'Não foi possível enviar agora. Tente de novo em instantes, ou me conte pelo WhatsApp.';
      erro.classList.remove('hidden');
    }
  });
</script>
