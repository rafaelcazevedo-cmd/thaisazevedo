---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Section from '@/components/Section.astro';
import WhatsAppButton from '@/components/WhatsAppButton.astro';
import { site } from '@/config/site';
import { depoimentos } from '@/data/depoimentos';

const title = `Vidas Transformadas, depoimentos sobre ${site.professionalName}`;
const description = `Histórias de famílias atendidas por ${site.professionalName}, ${site.profession.toLowerCase()} em ${site.city}. Leia os depoimentos e compartilhe a sua história.`;
---

<BaseLayout title={title} description={description} path="/vidas-transformadas">
  <Breadcrumbs items={[{ label: 'Início', href: '/' }, { label: 'Vidas Transformadas', href: '/vidas-transformadas' }]} />

  <Section eyebrow="Depoimentos" title="Vidas Transformadas" as="h1">
    <p class="max-w-2xl text-lg leading-relaxed text-ink/90">
      Cada criança que aprende a confiar em si transforma a vida de uma família inteira.
      Aqui, quem já viveu essa transformação conta como foi.
    </p>

    <!-- Depoimentos: mais recentes primeiro, texto completo, sem "ler mais".
         Pedido da Thais (CR-19): o máximo de depoimentos inteiros visíveis por
         tela, em boxes — colunas no desktop, coluna única no celular. -->
    {depoimentos.length > 0 ? (
      <div class="mt-10 columns-1 gap-6 md:columns-2">
        {depoimentos.map((d) => (
          <blockquote class="mb-6 break-inside-avoid rounded-2xl border border-brand-100 bg-paper p-6 sm:p-8">
            <p class="whitespace-pre-line font-display text-lg leading-relaxed text-ink">{d.texto}</p>
            <footer class="mt-4 font-semibold text-brand-700">
              — {d.nome}{d.paciente && <span class="font-normal text-muted"> · {d.paciente}</span>}
            </footer>
          </blockquote>
        ))}
      </div>
    ) : (
      <p class="mt-10 rounded-2xl border border-dashed border-brand-200 bg-brand-50/50 p-8 text-center font-display text-xl text-brand-700">
        As primeiras histórias vão aparecer aqui em breve. Que tal começar pela sua?
      </p>
    )}
  </Section>

  <Section class="bg-white" narrow>
    <div class="rounded-3xl border border-brand-100 bg-cream p-7 text-center sm:p-10">
      <h2 class="font-display text-2xl font-semibold text-brand-800 sm:text-3xl">
        Como esse atendimento mudou sua vida? Conta pra gente!
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-ink/90">
        Me mande seu depoimento pelo WhatsApp, escrito do seu jeito e no seu tempo.
        Ele ganha um lugar de carinho nesta página.
      </p>
      <div class="mt-7 flex justify-center">
        <WhatsAppButton
          size="lg"
          label="Enviar meu depoimento"
          message="Olá, Thais! Quero compartilhar meu depoimento sobre o atendimento: "
        />
      </div>
    </div>
  </Section>
</BaseLayout>
